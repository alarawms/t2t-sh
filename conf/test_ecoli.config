/*
 * E. coli test configuration
 * Real genome dataset for complete pipeline validation with BUSCO
 */

params {
    config_profile_name        = 'E. coli test profile'
    config_profile_description = 'Real E. coli synthetic dataset for full pipeline validation'

    // Override max resources for testing
    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '2.h'

    // E. coli test input
    input      = 'test_data/samplesheet_ecoli.csv'
    outdir     = 'results_ecoli'

    // Real genome size (E. coli K-12)
    genome_size    = '4.6m'

    // Enable BUSCO for quality assessment
    busco_lineage  = 'bacteria_odb10'
    busco_mode     = 'genome'
}

// Resource requirements for E. coli assembly
process {
    withLabel: process_single {
        cpus   = 1
        memory = 2.GB
        time   = 30.m
    }

    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }

    withLabel: process_medium {
        cpus   = 4
        memory = 6.GB
        time   = 1.h
    }

    withLabel: process_high {
        cpus   = 4
        memory = 8.GB
        time   = 2.h
    }

    withLabel: process_very_high {
        cpus   = 4
        memory = 8.GB
        time   = 2.h
    }
}
