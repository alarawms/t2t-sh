/*
 * KAUST Ibex Configuration
 * Adapted from nf-core/configs/kaust.config
 */

params {
    config_profile_name        = 'KAUST Ibex'
    config_profile_description = 'Configuration for KAUST Ibex SLURM cluster'
    config_profile_contact     = 'KAUST Research Computing'
    config_profile_url         = 'https://docs.hpc.kaust.edu.sa/quickstart/ibex.html'

    // Override max resources for Ibex
    max_memory                 = 16.TB
    max_cpus                   = 1300
    max_time                   = 14.d
}

// Singularity configuration for Ibex
singularity {
    enabled      = true
    autoMounts   = true
    pullTimeout  = '60 min'
    cacheDir     = "/ibex/user/$USER/.singularity/nf_images/"
}

// Process configuration
process {
    executor       = 'slurm'
    queue          = 'batch'
    clusterOptions = null

    // Load Singularity module before execution
    beforeScript   = 'module load singularity'

    // Retry strategy for Ibex-specific exit codes
    errorStrategy  = { task.exitStatus in [143,137,104,134,139,151,140,247,12] ? 'retry' : 'finish' }
    maxRetries     = 5

    // Resource limits specific to Ibex
    resourceLimits = [
        memory: 16.TB,
        cpus: 1300,
        time: 14.d
    ]

    // Optimized resource allocations for Ibex nodes
    withLabel: process_single {
        time = 20.h
    }

    withLabel: process_low {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 12 * task.attempt }
        memory = { 97.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = 32
        memory = { 200.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    withLabel: process_very_high {
        cpus   = 64
        memory = { 500.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }

    withLabel: process_long {
        time   = { 96.h * task.attempt }
    }
}

// Executor settings
executor {
    queueSize = 100
    submitRateLimit = '10 sec'
}
