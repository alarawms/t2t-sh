/*
 * Test configuration
 * Minimal resources for quick testing
 */

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset for pipeline validation'

    // Override max resources for testing
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Test input
    input      = 'test_data/samplesheet_test.csv'
    outdir     = 'results_test'

    // Small genome for testing
    genome_size    = '10m'

    // Skip BUSCO for tiny test data (dataset too small for meaningful results)
    // Note: 2Mb test data will show 0% complete BUSCOs with bacteria_odb10
    // To test BUSCO, use real dataset with --busco_lineage parameter
    busco_lineage  = null
}

// Reduce resource requirements for testing
process {
    withLabel: process_single {
        cpus   = 1
        memory = 1.GB
        time   = 1.h
    }

    withLabel: process_low {
        cpus   = 1
        memory = 2.GB
        time   = 2.h
    }

    withLabel: process_medium {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }

    withLabel: process_high {
        cpus   = 2
        memory = 6.GB
        time   = 6.h
    }

    withLabel: process_very_high {
        cpus   = 2
        memory = 6.GB
        time   = 6.h
    }
}
